{
  "version": "2.0",
  "fonts": [
    {
      "family": "Magic School One",
      "weight": 400,
      "style": "normal",
      "path": "/home/lkukhale/MagicSchoolOne.ttf"
    }
  ],
  "figure": {
    "background": "#dabd90",
    "padding": {
      "left": 5.0,
      "right": 5.0,
      "top": 5.0,
      "bottom": 5.0
    },
    "title": {
      "text": "Histogram Plot",
      "fontFamily": "Magic School One",
      "fontSize": 42.0,
      "color": "#32200d",
      "box": {
        "height": null
      }
    }
  },
  "datasets": [
    {
      "name": "Gryffindor",
      "schema": {
        "x": "number"
      }
    },
    {
      "name": "Hufflepuff",
      "schema": {
        "x": "number"
      }
    },
    {
      "name": "Ravenclaw",
      "schema": {
        "x": "number"
      }
    },
    {
      "name": "Slytherin",
      "schema": {
        "x": "number"
      }
    }
  ],
  "panels": [
    {
      "padding": {
        "left": 0.0,
        "right": 25.0,
        "top": 0.0,
        "bottom": 0.0
      },
      "xAxis": {
        "gridColor": "#222f5b",
        "lineColor": "#222f5b",
        "lineWidth": 2.0,
        "tickColor": "#222f5b",
        "tickWidth": 2.0,
        "tickLabel": {
          "fontFamily": "Magic School One",
          "fontSize": 32.0,
          "color": "#32200d"
        },
        "title": {
          "text": "Score",
          "fontFamily": "Magic School One",
          "fontSize": 42.0,
          "color": "#32200d",
          "box": {
            "height": null
          }
        }
      },
      "yAxis": {
        "gridColor": "#222f5b",
        "lineColor": "#222f5b",
        "lineWidth": 2.0,
        "tickColor": "#222f5b",
        "tickWidth": 2.0,
        "tickLabel": {
          "fontFamily": "Magic School One",
          "fontSize": 32.0,
          "color": "#32200d"
        },
        "title": {
          "text": "Density",
          "fontFamily": "Magic School One",
          "fontSize": 32.0,
          "fontWeight": 400,
          "color": "#32200d",
          "hAlign": "left",
          "vAlign": "top",
          "orientation": "verticalCounterClockwise",
          "box": {
            "height": null
          }
        }
      },
      "layers": [
        {
          "id": "Gryffindor",
          "type": "histogram",
          "dataset": "Gryffindor",
          "mapping": {
            "data": {
              "field": "x"
            }
          },
          "style": {
            "fillColor": "#ae0001b4",
            "strokeColor": "#740001"
          },
          "config": {
            "valueMode": "density"
          }
        },
        {
          "id": "Hufflepuff",
          "type": "histogram",
          "dataset": "Hufflepuff",
          "mapping": {
            "data": {
              "field": "x"
            }
          },
          "style": {
            "fillColor": "#f0c75eb4",
            "strokeColor": "#ecb939"
          },
          "config": {
            "valueMode": "density"
          }
        },
        {
          "id": "Ravenclaw",
          "type": "histogram",
          "dataset": "Ravenclaw",
          "mapping": {
            "data": {
              "field": "x"
            }
          },
          "style": {
            "fillColor": "#222f5bb4",
            "strokeColor": "#0e1a40"
          },
          "config": {
            "valueMode": "density"
          }
        },
        {
          "id": "Slytherin",
          "type": "histogram",
          "dataset": "Slytherin",
          "mapping": {
            "data": {
              "field": "x"
            }
          },
          "style": {
            "fillColor": "#2a623db4",
            "strokeColor": "#1a472a"
          },
          "config": {
            "valueMode": "density"
          }
        }
      ]
    }
  ]
}
