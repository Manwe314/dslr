        "legendElements": [
          {
            "iconShape": "circle",
            "iconColor": "#ecb939",
            "label": {
              "text": "Hufflepuff",
              "fontFamily": "Magic School One",
              "fontSize": 30.0
            }
          },
          {
            "id": "legend_element_2",
            "iconShape": "circle",
            "iconColor": "#0e1a40",
            "label": {
              "text": "Ravenclaw",
              "fontFamily": "Magic School One",
              "fontSize": 30.0
            }
          },
          {
            "id": "legend_element_3",
            "iconShape": "circle",
            "iconColor": "#1a472a",
            "label": {
              "text": "Slytherin",
              "fontFamily": "Magic School One",
              "fontSize": 30.0
            }
          },
          {
            "id": "legend_element_4",
            "iconShape": "circle",
            "iconColor": "#740001",
            "label": {
              "text": "Gryffindor",
              "fontFamily": "Magic School One",
              "fontSize": 30.0
            }
          }
        ]
      }
    ]
  },
